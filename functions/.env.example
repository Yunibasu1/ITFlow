# Variables de entorno de la Cloud Function (Firebase Functions v2).
# Copia este archivo a `.env` y rellena los valores.
# Este archivo NO se sube a git (está en .gitignore).

# API key de Google Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-api-key

# --- Correo de notificaciones (SMTP genérico) ---
# Funciona con Brevo (recomendado, gratuito, sin dominio), Gmail, etc.
# Brevo: https://www.brevo.com → gratis → 300 correos/día.
#   SMTP_HOST    = smtp-relay.brevo.com
#   SMTP_USER    = tu correo verificado como remitente en Brevo
#   SMTP_PASS    = Master Password (SMTP key) que genera Brevo
# Gmail (alternativa): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
#   SMTP_USER=tu-cuenta@gmail.com, SMTP_PASS=contraseña-de-aplicación
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu-correo-verificado@empresa.com
SMTP_PASS=tu-smtp-key-de-brevo
# Nombre que aparece como remitente de los correos.
SMTP_FROM_NAME=ITFlow

# URL base pública de la app (para los enlaces de los emails).
# Opcional: por defecto usa https://itflow-4a74b.web.app
APP_URL=https://itflow-4a74b.web.app
