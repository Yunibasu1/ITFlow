# Variables de entorno de la Cloud Function (Firebase Functions v2).
# Copia este archivo a `.env` y rellena los valores.
# Este archivo NO se sube a git (está en .gitignore).

# Secreto compartido del webhook de clasificación.
# DEBE ser el mismo que VITE_N8N_WEBHOOK_SECRET en frontend/.env(.production).
ITFLOW_WEBHOOK_SECRET=generate-a-long-random-string

# API key de Google Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-api-key
