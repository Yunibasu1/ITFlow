# Variables de entorno de la función Vercel (reemplaza a la Cloud Function).
# Copia este archivo a `.env` o súbelas con `vercel env add`.
# Este archivo NO se sube a git.

# API key de Google Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-api-key

# Service account JSON de Firebase (una sola línea, igual que GOOGLE_SERVICE_ACCOUNT_JSON en n8n).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
