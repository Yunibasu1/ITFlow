# Copia este archivo a `.env` en el VPS y rellena los valores.
# Este archivo NO se sube a git (está en .gitignore).

# Dominio público de n8n (sin https:// ni www).
# Debe apuntar con un registro A a la IP del VPS.
N8N_HOST=n8n.tudominio.com

# Clave para cifrar las credenciales de n8n (mínimo 32 caracteres).
# Puede reutilizar la misma del .env local para heredar el workflow y las credenciales.
N8N_ENCRYPTION_KEY=generate-a-long-random-string-of-at-least-32-chars

# Usuario y contraseña del panel de n8n.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Zona horaria (opcional, por defecto UTC).
GENERIC_TIMEZONE=America/Caracas

# Secreto compartido del webhook de clasificación.
# DEBE ser el mismo que VITE_N8N_WEBHOOK_SECRET en frontend/.env.production.
N8N_WEBHOOK_SECRET=generate-another-long-random-string

# API key de Google Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-api-key

# ID del proyecto de Firebase/Google Cloud (el mismo de frontend/.env).
GOOGLE_CLOUD_PROJECT=itflow-4a74b

# Permitir leer $env dentro de nodos Code/expresiones (necesario para el Code node de Firestore).
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Módulos de Node permitidos en los nodos Code (para el PATCH a Firestore).
NODE_FUNCTION_ALLOW_BUILTIN=crypto,fs,https,http

# JSON completo (una sola línea) del service account que escribe en Firestore.
# Se genera con: Get-Content google-service-account.json -Raw | ConvertFrom-Json | ConvertTo-Json -Depth 6 -Compress
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"itflow-4a74b", ...}
